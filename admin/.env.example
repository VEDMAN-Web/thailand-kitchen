NEXT_PUBLIC_API_URL=/api
BACKEND_URL=http://127.0.0.1:5000

# Public origin for /uploads paths saved into Varsovia CMS (no trailing slash).
# Required for the live Varsovia site to load admin-uploaded images when Cloudinary is off.
# Example: https://your-thailand-api.example.com
# NEXT_PUBLIC_UPLOAD_PUBLIC_URL=http://127.0.0.1:5000

# External Varsovia API.
# Auth uses your Thailand Kitchen admin login (JWT).
# VARSOVIA_ADMIN_KEY stays server-side only (must match Varsovia backend ADMIN_KEY).
VARSOVIA_API_URL=https://varsovia-design.onrender.com/api
VARSOVIA_ADMIN_KEY=
