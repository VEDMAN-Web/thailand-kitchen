PORT=5000
MONGO_URI=your_mongodb_atlas_uri
MONGO_DB_NAME=thailandKitchen
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@thailandkitchens.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Admin
ADMIN_URL=https://your-admin.vercel.app
CLIENT_URL=https://your-client.vercel.app
CORS_ORIGINS=https://your-admin.vercel.app,https://your-client.vercel.app
PUBLIC_API_URL=http://127.0.0.1:5000
# Optional — if set, uploads go to Cloudinary instead of local /uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# OpenAI — blog text drafts + cover image generation (sk-proj-... keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Image model preference (gpt-image-1 recommended; falls back automatically)
OPENAI_IMAGE_MODEL=gpt-image-1
# Optional Gemini cover images (only if you use a Google AI Studio key)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Optional force provider: openai | gemini
# AI_IMAGE_PROVIDER=openai
