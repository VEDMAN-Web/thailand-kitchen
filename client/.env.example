# Copy to .env.local for local development (never commit secrets)

# Same-origin API (recommended for Vercel)
NEXT_PUBLIC_API_URL=/api

# MongoDB Atlas connection string (required for contact form)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Database name (optional, default: thailandKitchen)
MONGO_DB_NAME=thailandKitchen
